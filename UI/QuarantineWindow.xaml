<Window x:Class="xScanner.UI.QuarantineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quarantine" Height="350" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DgQuarantine" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Threat Name" Binding="{Binding ThreatName}" Width="120"/>
                <DataGridTextColumn Header="Original Path" Binding="{Binding OriginalPath}" Width="200"/>
                <DataGridTextColumn Header="Time" Binding="{Binding QuarantineTime}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Restore Selected" Click="BtnRestore_Click" Width="120" Height="30" Margin="5"/>
            <Button Content="Delete Permanently" Click="BtnDelete_Click" Width="130" Height="30" Margin="5" Background="#DC3545" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
