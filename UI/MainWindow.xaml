<Window x:Class="xScanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xScanner" Height="500" Width="450"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeWindowBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <DockPanel Grid.Row="0" Background="{DynamicResource ThemeHeaderBackground}" LastChildFill="False">
            <TextBlock Text="xScanner" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="{DynamicResource ThemeTextColor}"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,10,0">
                <Button Content="🛡 Quarantine" Click="BtnQuarantine_Click" Margin="5" Padding="8,4"/>
                <Button Content="📜 History" Click="BtnHistory_Click" Margin="5" Padding="8,4"/>
                <Button Content="⚙" Click="BtnSettings_Click" FontSize="18" Width="38" Height="32" Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- Main PC Status Area -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Width="380" Height="240" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="PC STATUS" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedTextColor}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="CLEAN" FontSize="36" FontWeight="Bold" Foreground="#28A745" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                    <TextBlock x:Name="TxtLastScan" Text="Last Scan: Never" FontSize="13" Foreground="{DynamicResource ThemeSubTextColor}" HorizontalAlignment="Center" Margin="0,2"/>
                    <TextBlock x:Name="TxtFilesScanned" Text="Files Scanned: 0" FontSize="13" Foreground="{DynamicResource ThemeSubTextColor}" HorizontalAlignment="Center" Margin="0,2"/>
                    <TextBlock x:Name="TxtThreatsFound" Text="Threats Found: 0" FontSize="13" Foreground="{DynamicResource ThemeSubTextColor}" HorizontalAlignment="Center" Margin="0,2,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnBasicScan" Content="BASIC SCAN" Click="BtnBasicScan_Click" Width="120" Height="38" Margin="5" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                        <Button x:Name="BtnFullScan" Content="FULL SCAN" Click="BtnFullScan_Click" Width="120" Height="38" Margin="5" Background="#6C757D" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtProgress" Text="" FontSize="12" Foreground="{DynamicResource ThemeSubTextColor}" HorizontalAlignment="Center" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" Width="340"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer ClamAV status -->
        <StatusBar Grid.Row="2" Background="{DynamicResource ThemeStatusBarBackground}">
            <StatusBarItem>
                <TextBlock x:Name="TxtClamStatus" Text="ClamAV: Ready" FontSize="12" Foreground="{DynamicResource ThemeTextColor}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtDefinitionStatus" Text="Last Update: Today" FontSize="12" Foreground="{DynamicResource ThemeTextColor}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
