<Window x:Class="xScanner.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="400" Width="400"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <StackPanel>
            <TextBlock Text="Automatic Scan Settings" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Mode:" Width="80" VerticalAlignment="Center"/>
                <ComboBox x:Name="CbAutoMode" Width="200">
                    <ComboBoxItem Content="Disabled"/>
                    <ComboBoxItem Content="Basic"/>
                    <ComboBoxItem Content="Full"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Full Scan Exclusions" FontWeight="Bold" Margin="0,10,0,5"/>
            <ListBox x:Name="LbExclusions" Height="80" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="TxtNewExclusion" Width="220" Margin="0,0,5,0"/>
                <Button Content="Add" Click="BtnAddExclusion_Click" Width="70"/>
                <Button Content="Remove" Click="BtnRemoveExclusion_Click" Width="70" Margin="5,0,0,0"/>
            </StackPanel>

            <TextBlock Text="ClamAV Path" FontWeight="Bold" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtClamPath" Margin="0,0,0,15"/>

            <Button Content="Save Settings" Click="BtnSave_Click" Width="120" Height="30" HorizontalAlignment="Right" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
