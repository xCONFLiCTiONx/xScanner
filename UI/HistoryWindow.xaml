<Window x:Class="xScanner.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan History &amp; Results" Height="350" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBackground}">
    <Grid Margin="10">
        <DataGrid x:Name="DgHistory" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding ScanType}" Width="80"/>
                <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="130"/>
                <DataGridTextColumn Header="Examined" Binding="{Binding FilesExamined}" Width="80"/>
                <DataGridTextColumn Header="Threats" Binding="{Binding ThreatsDetected}" Width="70"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
