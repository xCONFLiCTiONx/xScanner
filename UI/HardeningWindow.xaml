<Window x:Class="xScanner.UI.HardeningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Hardening &amp; Security Audit" Height="700" Width="760"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBackground}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Header Summary Card -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Score Badge -->
                <Border Grid.Column="0" Background="#1A28A745" BorderBrush="#28A745" BorderThickness="2" CornerRadius="10" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SCORE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedTextColor}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtScore" Text="0%" FontSize="32" FontWeight="Bold" Foreground="#28A745" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtScoreStatus" Text="Auditing..." FontSize="10" Foreground="{DynamicResource ThemeSubTextColor}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Status Metrics -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                    <TextBlock Text="SYSTEM HARDENING STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedTextColor}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSummaryTitle" Text="Security Audit In Progress..." FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextColor}" Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtPassedCount" Text="Passed: 0/0" FontSize="12" Foreground="#28A745" FontWeight="SemiBold" Margin="0,0,15,0"/>
                        <TextBlock x:Name="TxtFailedCount" Text="Vulnerable: 0/0" FontSize="12" Foreground="#DC3545" FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtNetworkDnsInfo" Text="Network: Scanning... | DNS: Scanning..." FontSize="11" Foreground="{DynamicResource ThemeSubTextColor}"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Vertical">
                    <Button x:Name="BtnHarden" Content="HARDEN SYSTEM" Click="BtnHarden_Click" Width="150" Height="38" Background="#28A745" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnRefresh" Content="Refresh Audit" Click="BtnRefresh_Click" Width="150" Height="28" Background="{DynamicResource ThemeControlBackground}" Foreground="{DynamicResource ThemeTextColor}" FontSize="11" BorderBrush="{DynamicResource ThemeBorderBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Area -->
        <TabControl Grid.Row="1" Margin="0,0,0,10" Background="Transparent" BorderBrush="{DynamicResource ThemeBorderBrush}">
            <!-- Tab 1: Hardening Checks -->
            <TabItem Header="Security Hardening Controls">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IcChecks" Margin="5">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon -->
                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{Binding StatusColor}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextColor}"/>
                                                <Border Background="{DynamicResource ThemeControlBackground}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource ThemeMutedTextColor}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource ThemeSubTextColor}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CurrentValue}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="2" Background="{DynamicResource ThemeControlBackground}" BorderBrush="{Binding StatusColor}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusColor}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Listening Ports & System Details -->
            <TabItem Header="Active Open Ports &amp; Shielding">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Active Non-Loopback Listening TCP Ports:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextColor}" Margin="0,5,0,8"/>

                    <DataGrid x:Name="DgPorts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeTextColor}"
                              RowBackground="{DynamicResource ThemeCardBackground}" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource ThemeBorderBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="65"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="65"/>
                            <DataGridTextColumn Header="Process Name" Binding="{Binding ProcessName}" Width="150"/>
                            <DataGridTextColumn Header="Local Address" Binding="{Binding LocalAddress}" Width="140"/>
                            <DataGridTextColumn Header="Sensitive Description" Binding="{Binding SensitiveDescription}" Width="*"/>
                            <DataGridTemplateColumn Header="Shielding Status" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Audit Log Terminal -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource ThemeTextColor}" Margin="0,0,5,0"/>
                        <TextBlock Text="Audit &amp; Hardening Execution Terminal" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextColor}"/>
                    </StackPanel>
                    <Button Content="Clear" Click="BtnClearTerminal_Click" DockPanel.Dock="Right" FontSize="10" Padding="6,1"/>
                </DockPanel>

                <TextBox x:Name="TxtTerminal" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="11"
                         Background="{DynamicResource ThemeControlBackground}"
                         Foreground="{DynamicResource ThemeTextColor}"
                         BorderBrush="{DynamicResource ThemeBorderBrush}"
                         VerticalScrollBarVisibility="Auto" Padding="6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
